# Copy to .env and fill in. Never commit .env.

# Used by the db container to create the database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=garbagego

# Used inside the api container (host name "db").
DATABASE_URL=postgresql+psycopg://USER:PASS@db:5432/garbagego

# Used on your own computer (tests, import scripts).
HOST_DATABASE_URL=postgresql+psycopg://USER:PASS@localhost:5432/garbagego
TEST_DATABASE_URL=postgresql+psycopg://USER:PASS@localhost:5432/garbagego_test
